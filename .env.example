# 机器本地解释器路径模板：cp .env.example .env 后按本机实际修改（.env 不提交）
# PY_BIN — Python 3 解释器（巡检锁、风控写入、历史存储、launchd 安装器共用）
# NODE_BIN — Node >= 22（wrangler、analyze、dashboard 需要；launchd PATH 由此推导）
PY_BIN=/path/to/python3
NODE_BIN=/path/to/node
# BG_PROXY — 出海代理（Node 不读系统代理；公网 API 需显式指定），如 http://127.0.0.1:7890
BG_PROXY=http://127.0.0.1:7890
